---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts, tagCounts, tagFolder } from '../../utils/post';

export async function getStaticPaths() {
  const posts = await getPosts();
  // 两个标签可能被压成同一个目录名（例如 "a:b" 与 "a-b"），这里按目录合并，避免路由重复
  const byFolder = new Map<string, { tag: string; posts: typeof posts }>();
  for (const { tag, posts: list } of tagCounts(posts)) {
    const folder = tagFolder(tag);
    const cur = byFolder.get(folder);
    if (cur) cur.posts = [...cur.posts, ...list];
    else byFolder.set(folder, { tag, posts: list });
  }
  return [...byFolder.entries()].map(([folder, props]) => ({
    params: { tag: folder },
    props,
  }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Awaited<ReturnType<typeof getPosts>> };
---

<BaseLayout title={`标签：${tag}`} description={`${tag}：${posts.length} 篇文章`}>
  <h1 class="page-title">
    <span aria-hidden="true">#</span>{tag}
  </h1>
  <p class="page-lead">
    共 {posts.length} 篇 · <a href="/tags/">全部标签</a>
  </p>
  <div class="post-list">
    {posts.map((post) => <PostItem post={post} />)}
  </div>
</BaseLayout>
