---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404">
  <div class="notfound">
    <p class="notfound__code">404</p>
    <h1>这个地址没有内容</h1>
    <p>链接可能已经失效，或者你输错了地址。</p>
    <p><a href="/">返回首页</a> · <a href="/archive/">浏览归档</a></p>
  </div>
</BaseLayout>
