---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { CATEGORIES } from '../data/categories';
import { getPosts } from '../utils/post';

const posts = await getPosts();
---

<BaseLayout title="关于" description={`关于 ${SITE.title} 与作者 ${SITE.author}`}>
  <h1 class="page-title">关于</h1>
  <div class="prose page-body">
    <p>
      这里是 {SITE.author} 的个人博客，主要记录 {SITE.tagline}。目前共 {posts.length} 篇。
    </p>
    <h2>内容怎么组织</h2>
    <p>
      文章按 <a href="/categories/">专栏</a> 组织：{CATEGORIES.length} 个大类（C 语言、C++、数据结构与算法、并发编程、Qt 6、
      Windows/Win32、Linux 系统编程、操作系统原理、计算机网络、嵌入式、数据库、编译与构建、调试与性能、工程实践），
      每个大类内部按「基础 → 进阶 → 高级」拆成若干章节，构成一张完整的学习地图。
      还没写的章节会先占位显示「敬请期待」，写到哪填到哪。
    </p>
    <h2>这个站怎么搭的</h2>
    <ul>
      <li>用 <a href="https://astro.build">Astro</a> 的内容集合管理文章，Markdown 写作，构建出纯静态页面。</li>
      <li>托管在 GitHub Pages，推送到 <code>main</code> 分支后由 GitHub Actions 自动构建部署。</li>
      <li>没有第三方框架 UI，样式是自己写的一套，深浅色主题跟随系统，也可以手动切换。</li>
      <li>评论走 <a href="https://giscus.app">Giscus</a>，讨论内容存在 GitHub Discussions 里。</li>
    </ul>
    <h2>联系我</h2>
    <p>
      想交流可以在文章底下留言，或者订阅 <a href="/rss.xml">RSS</a>。
    </p>
    <blockquote>
      <p>把这一页换成你自己的介绍（包括邮箱、社交链接）。</p>
    </blockquote>
  </div>
</BaseLayout>
