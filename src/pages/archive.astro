---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, groupByYear, formatDate, isoDate, postPath } from '../utils/post';

const posts = await getPosts();
const years = groupByYear(posts);
---

<BaseLayout title="归档" description={`${posts.length} 篇文章的时间线`}>
  <h1 class="page-title">归档</h1>
  <p class="page-lead">按时间倒序排列，共 {posts.length} 篇。</p>
  {
    years.map(([year, list]) => (
      <>
        <h2 class="archive-year">{year} · {list.length} 篇</h2>
        <ul class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date).slice(5)}</time>
              <a href={postPath(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</BaseLayout>
