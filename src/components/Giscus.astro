---
import { GISCUS } from '../config';

const { enabled = true } = Astro.props as { enabled?: boolean };
const ready = enabled && GISCUS.repo && GISCUS.repoId && GISCUS.categoryId;
---

{
  ready && (
    <section class="comments" id="comments">
      <h2 class="comments__title">评论</h2>
      <div id="giscus-thread"></div>
      <script
        is:inline
        id="giscus-src"
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
      <script>
        const root = document.documentElement;
        const themeUrl = (dark: boolean) =>
          dark ? 'https://giscus.app/themes/dark_dimmed.css' : 'https://giscus.app/themes/light.css';
        const apply = (dark: boolean) => {
          document.getElementById('giscus-src')?.setAttribute('data-theme', themeUrl(dark));
          document
            .querySelector<HTMLIFrameElement>('#giscus-thread iframe.giscus-frame')
            ?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeUrl(dark) } } }, 'https://giscus.app');
        };
        const isDark = () => root.dataset.theme === 'dark';
        apply(isDark());
        root.addEventListener('themechange', (e) => apply((e as CustomEvent<string>).detail === 'dark'));
      </script>
    </section>
  )
}
