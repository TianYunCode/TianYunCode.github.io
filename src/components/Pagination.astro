---
const { page, total, baseUrl = '/page' } = Astro.props as {
  page: number;
  total: number;
  baseUrl?: string;
};

const href = (p: number) => (p === 1 ? '/' : `${baseUrl}/${p}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="文章分页">
      {page > 1 && <a href={href(page - 1)} rel="prev">← 上一页</a>}
      {pages.map(
        (p) =>
          p === page ? (
            <span aria-current="page">{p}</span>
          ) : (
            <a href={href(p)}>{p}</a>
          )
      )}
      {page < total && <a href={href(page + 1)} rel="next">下一页 →</a>}
    </nav>
  )
}
