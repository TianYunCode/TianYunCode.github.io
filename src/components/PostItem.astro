---
import { formatDate, isoDate, readingMinutes, postPath, type Post } from '../utils/post';
import { CATEGORY_MAP, SECTION_INDEX } from '../data/categories';

const { post } = Astro.props as { post: Post };
const minutes = readingMinutes(post.body ?? '');
const category = post.data.category ? CATEGORY_MAP.get(post.data.category) : undefined;
const section = post.data.section ? SECTION_INDEX.get(post.data.section)?.section : undefined;
---

<article class="post-item">
  <h2 class="post-item__title">
    <a href={postPath(post)}>{post.data.title}</a>
  </h2>
  <p class="post-item__desc">{post.data.description}</p>
  <div class="meta">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <span class="meta__dot" aria-hidden="true"></span>
    <span>{minutes} 分钟阅读</span>
    {
      category && (
        <a class="chip chip--cat" href={section ? `/categories/${category.slug}/#${section.id}` : `/categories/${category.slug}/`}>
          {category.title}
          {section && ` · ${section.title}`}
        </a>
      )
    }
    {
      post.data.tags.map((tag) => (
        <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
          {tag}
        </a>
      ))
    }
  </div>
</article>
